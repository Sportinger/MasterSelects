{
  "name": "cut-a-video",
  "project": "My first edit",
  "viewport": { "width": 1280, "height": 720 },
  "scale": 2,
  "output": { "width": 1920, "height": 1080, "fps": 30 },
  "voice": { "voice": "flamer", "stability": 0.5 },
  "captions": { "size": 66, "maxWords": 4 },
  "media": {
    "opera_house.mp4": "opera_house_dolly.mp4",
    "dancer.mp4": "dancer_stage_motion.mp4"
  },
  "hide": [".project-media-copy-toast"],
  "scenes": [
    {
      "id": "intro",
      "say": "Here's how to cut your first video in MasterSelects. It takes less than a minute.",
      "camera": "all",
      "tail": 0.2,
      "steps": [
        { "card": { "title": "Cut your first video", "subtitle": "in under a minute" }, "ms": 3800 }
      ]
    },
    {
      "id": "import",
      "say": "Open the editor in your browser, and drag your clips from the desktop straight into the Media panel.",
      "camera": { "box": [0, 30, 760, 430] },
      "steps": [
        { "files": ["opera_house.mp4", "dancer.mp4"], "at": "pane:preview-group:0.1,0.2" },
        { "pick": [0, 1] },
        { "dropFiles": "pane:left-group:0.45,0.45" },
        { "waitFor": "media", "count": 2 },
        { "pause": 400 }
      ]
    },
    {
      "id": "timeline",
      "say": "Then drag the first clip onto the timeline, and drop the second one right behind it.",
      "camera": { "box": [0, 110, 960, 540] },
      "steps": [
        { "drag": "opera_house.mp4@left-group", "to": "time:0.02@Video 1", "label": "opera_house.mp4", "ms": 1300 },
        { "pause": 300 },
        { "drag": "dancer.mp4@left-group", "to": "time:6.5@Video 1", "label": "dancer.mp4", "ms": 1300 },
        { "pause": 300 }
      ]
    },
    {
      "id": "trim",
      "say": "To trim a clip, grab its edge and pull it in.",
      "camera": { "box": [150, 300, 720, 405] },
      "captions": "top",
      "steps": [
        { "drag": "clip:opera_house.mp4:end", "to": "time:3.6@Video 1", "ms": 1100 }
      ]
    },
    {
      "id": "move",
      "say": "Then slide the next clip over. It snaps right into place.",
      "captions": "top",
      "steps": [
        { "drag": "clip:dancer.mp4:middle", "to": "time:6.55@Video 1", "ms": 1200 }
      ]
    },
    {
      "id": "split",
      "say": "Press C for the blade, and click wherever you want to cut.",
      "captions": "top",
      "steps": [
        { "move": "clip:dancer.mp4:3.4" },
        { "key": "c", "label": "C" },
        { "click": "clip:dancer.mp4:3.4" },
        { "pause": 300 },
        { "key": "v", "label": "V" }
      ]
    },
    {
      "id": "delete",
      "say": "Select the part you don't need, and delete it.",
      "captions": "top",
      "steps": [
        { "click": "clip:dancer.mp4#2:middle" },
        { "key": "Delete", "label": "Delete" }
      ]
    },
    {
      "id": "play",
      "say": "Press space to watch your edit.",
      "steps": [
        { "click": "ruler:1.6" },
        { "camera": { "panes": ["preview-group"], "maxZoom": 1.6 }, "ms": 800 },
        { "move": "pane:preview-group:0.62,0.55" },
        { "key": "Space", "label": "Space" },
        { "pause": 3400 },
        { "key": "Space", "label": "Space" }
      ]
    },
    {
      "id": "outpoint",
      "say": "Click where your video should end, and press O to set the out point.",
      "camera": { "box": [480, 290, 800, 430] },
      "captions": "top",
      "steps": [
        { "click": "ruler:end" },
        { "key": "o", "label": "O" },
        { "pause": 300 }
      ]
    },
    {
      "id": "export",
      "say": "Then click Export. Your video renders right in the browser and lands in your downloads.",
      "captions": "top",
      "steps": [
        { "click": "Export@right-group" },
        { "pause": 500 },
        { "click": "button:Export" },
        { "waitFor": "download", "fast": 3, "timeout": 240 },
        { "pause": 1500 }
      ]
    },
    {
      "id": "outro",
      "say": "MasterSelects. Free, right in your browser.",
      "camera": "all",
      "steps": [
        { "card": { "title": "masterselects.com", "subtitle": "Free video editing, right in your browser" }, "ms": 3200, "keep": true }
      ]
    }
  ]
}
