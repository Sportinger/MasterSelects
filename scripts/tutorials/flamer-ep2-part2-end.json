{
  "name": "flamer-ep2-part2-end",
  "project": "Qualle",
  "about": "Builds checkpoint flamer-ep2-part2 (the Qualle project as part 2 ends: an empty Weave on a 20 s Blank, 9:16, the node group wide) without recording: node scripts/tutorial-video.mjs scripts/tutorials/flamer-ep2-part2-end.json --setup-only --save flamer-ep2-part2",
  "storage": {"settings": {"hasSeenTutorial": true, "hasSeenTutorialPart2": true, "nodeCableStyle": "curved"}},
  "hide": [".project-media-copy-toast"],
  "setup": [
    {"click": "time:0.05@Video 1", "button": "right", "ms": 250},
    {"click": "Add Layer", "ms": 250},
    {"move": "~250,0", "ms": 250},
    {"click": "Blank Clip", "ms": 250},
    {"waitFor": "clips", "count": 1, "timeout": 20},
    {"drag": "clip:Blank:end", "to": "time:20@Video 1", "ms": 400},
    {"expect": {"clip": {"name": "Blank", "start": 0, "end": 20}}},
    {"click": "clip:Blank:middle", "ms": 250},
    {"click": "Effects@right-group", "ms": 250},
    {"click": "+ Add Effect", "ms": 250},
    {"type": "weave", "delay": 20},
    {"pause": 900},
    {"click": "button:Weave", "ms": 250},
    {"pause": 1500},
    {"click": "Main Comp@left-group", "button": "right", "ms": 250},
    {"click": "Composition Settings...", "ms": 250, "after": 400},
    {"click": "aria:Switch to 9:16 portrait", "ms": 250},
    {"click": "Save", "ms": 250, "after": 300},
    {"drag": "Preview@preview-group", "to": "@14,660", "hold": 650, "ms": 600, "after": 500},
    {"click": "aria:Hide playback controls", "ms": 250},
    {"click": "Nodes@left-group", "ms": 250},
    {"drag": "handle:left-group:right", "to": "~600,0", "ms": 400},
    {"drag": "handle:left-group:bottom", "to": "~0,200", "ms": 400},
    {"click": "aria:Node graph source", "ms": 250},
    {"click": "option:Blank · Video 1", "ms": 250},
    {"pause": 1200},
    {"click": "Fit@left-group", "ms": 250},
    {"pause": 800},
    {"move": "aria:Weave@left-group", "ms": 250},
    {"pause": 300},
    {"click": "button:Expand Weave group", "ms": 250},
    {"pause": 2500},
    {"click": "Fit@left-group", "ms": 250},
    {"pause": 800},
    {"marquee": ["Weave Pattern", "Handmade", "Reveal by Shape", "Weave In", "Yarn", "Wind Cloth"], "ms": 400},
    {"press": "Delete", "after": 800},
    {"click": "Fit@left-group", "ms": 250},
    {"pause": 800},
    {"click": "Media@left-group", "ms": 250},
    {"click": "ruler:1", "ms": 250},
    {"pause": 1500},
    {"move": "pane:tab=Preview:0.5,0.45", "ms": 250},
    {"expect": {"playing": false, "playhead": 1, "clips": 1}}
  ],
  "resume": [
    {"click": "aria:Hide playback controls", "ms": 200},
    {"click": "Media@left-group", "ms": 200},
    {"click": "Main Comp@left-group", "ms": 200},
    {"click": "Effects@right-group", "ms": 200}
  ],
  "scenes": []
}
